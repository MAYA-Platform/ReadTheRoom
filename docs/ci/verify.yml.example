name: Verify ReadTheRoom
on:
  push:
  pull_request:
permissions:
  contents: read
jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
      - run: npm test
      - run: node --check scripts/read-the-room/readtheroomPublicServer.mjs
      - run: node --check scripts/read-the-room/readtheroomPolicy.js
      - run: node --check scripts/read-the-room/readtheroomCalibrationSession.js
